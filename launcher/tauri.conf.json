{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desiege",
  "version": "0.1.0",
  "identifier": "dev.desiege.launcher",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Desiege — Dungeon Siege Launcher", "width": 600, "height": 680, "resizable": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
